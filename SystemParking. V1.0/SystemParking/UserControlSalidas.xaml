<UserControl x:Class="SystemParking.UserControlSalidas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="0.8*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="30">
            <TextBlock Text="COBRO Y SALIDA" FontSize="26" FontWeight="Black" 
                       Foreground="#E67E22" VerticalAlignment="Top"/>

            <StackPanel VerticalAlignment="Center" MaxWidth="450">
                <TextBlock Text="Ingresar Placa para Salida" FontSize="16" Foreground="#34495E" Margin="0,0,0,8" FontWeight="SemiBold"/>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtBuscaPlaca" FontSize="24" FontWeight="Bold" 
                             CharacterCasing="Upper" Padding="10" BorderBrush="#E67E22" BorderThickness="2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button x:Name="btnBuscar" Grid.Column="1" Content="🔍 BUSCAR" Width="110" Margin="10,0,0,0" 
                            Background="#E67E22" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                            Click="btnBuscar_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <Border Background="White" Padding="30" CornerRadius="20" BorderBrush="#E5E7E9" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,10">
                            <TextBlock Text="Hora de Entrada:" FontSize="15" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="lblResumenEntrada" Text="--:--:--" HorizontalAlignment="Right" 
                                       FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                        </Grid>
                        <Grid Margin="0,10">
                            <TextBlock Text="Tiempo Transcurrido:" FontSize="15" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="lblTiempo" Text="0 min" HorizontalAlignment="Right" 
                                       FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                        </Grid>

                        <Separator Margin="0,20" Background="#E67E22" Opacity="0.2"/>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL A PAGAR" FontSize="14" FontWeight="Bold" Foreground="#E67E22" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblTotal" Text="$ 0.00" FontSize="48" FontWeight="Black" 
                                       Foreground="#E67E22" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="btnCobrar" Content="✅ REGISTRAR PAGO Y IMPRIMIR" Height="65" Margin="0,30,0,0"
                        Background="#27AE60" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" 
                        Cursor="Hand" Click="btnCobrar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="#EBEDEF" CornerRadius="30,0,0,30" Padding="40">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="VISTA PREVIA DE TICKET" FontSize="12" FontWeight="Bold" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Border Background="White" Padding="20" Width="260">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="PARKING EXPRESS" FontWeight="Black" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="LOS MOCHIS, SIN." FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Text="--------------------------------" HorizontalAlignment="Center" Foreground="#BDC3C7"/>

                        <Grid Margin="0,10">
                            <TextBlock Text="PLACA:" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ElementName=txtBuscaPlaca, Path=Text}" HorizontalAlignment="Right" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="ENTRADA:" FontSize="10"/>
                            <TextBlock Text="{Binding ElementName=lblResumenEntrada, Path=Text}" HorizontalAlignment="Right" FontSize="10"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="SALIDA:" FontSize="10"/>
                            <TextBlock Text="--:--:--" HorizontalAlignment="Right" FontSize="10"/>
                        </Grid>

                        <TextBlock Text="--------------------------------" HorizontalAlignment="Center" Foreground="#BDC3C7" Margin="0,10"/>

                        <TextBlock Text="TOTAL PAGADO" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ElementName=lblTotal, Path=Text}" HorizontalAlignment="Center" FontSize="22" FontWeight="Black"/>

                        <TextBlock Text="¡GRACIAS POR SU PREFERENCIA!" FontSize="9" HorizontalAlignment="Center" Margin="0,20,0,0" Foreground="#7F8C8D"/>

                        <Path Data="M0,0 L10,5 L20,0 L30,5 L40,0 L50,5 L60,0 L70,5 L80,0 L90,5 L100,0" 
                              Stretch="Fill" Fill="#EBEDEF" Height="10" Margin="0,20,0,-20"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Button x:Name="btnCerrarVista" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                Width="35" Height="35" Margin="20" Background="#FADBD8" 
                Foreground="#E74C3C" FontWeight="Bold" BorderThickness="0"
                Click="btnCerrarVista_Click" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="17"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</UserControl>