<Window x:Class="SystemParking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemParking"
        mc:Ignorable="d"
        Title="SystemParking - Gestión de Estacionamiento" 
        Height="720" Width="1280"
        WindowState="Maximized" 
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D8E0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F6F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50" CornerRadius="0,15,15,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1ABC9C" Margin="20,30,20,40" CornerRadius="8">
                    <TextBlock Text="PARKING EXPRESS" Foreground="White" FontSize="20" 
                       FontWeight="ExtraBold" Margin="10" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="1">
                    <Button x:Name="btnEntradas" Content="📥 Entradas" Style="{StaticResource MenuButtonStyle}" Click="Button_Click"/>
                    <Button x:Name="btnSalidas" Content="📤 Salidas (Cobro)" Style="{StaticResource MenuButtonStyle}" Click="btnSalidas_Click"/>
                    <Button x:Name="btnReportes" Content="📊 Reportes" Style="{StaticResource MenuButtonStyle}" Click="btnReportes_Click"/>
                    <Button x:Name="btnEstadoCupos" Content="🚗 Estado de Cupos" Style="{StaticResource MenuButtonStyle}" Click="btnEstadoCupos_Click"/>
                    <Button x:Name="btnConfiguracion" Content="⚙️ Configuración" Style="{StaticResource MenuButtonStyle}" Click="btnConfiguracion_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="10,0,10,15">
                    <TextBlock x:Name="lblReloj" Text="00:00:00 PM" 
               Foreground="White" FontSize="18" HorizontalAlignment="Center" 
               FontWeight="Light" Margin="0,0,0,10"/>

                    <Border Background="#34495E" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="20" VerticalAlignment="Center" Margin="5,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Usuario Activo:" FontSize="10" Foreground="#BDC3C7"/>
                                <TextBlock x:Name="lblNombreUsuario" Text="Invitado" 
                           Foreground="#1ABC9C" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="5,0,5,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Ellipse x:Name="indicatorRed" Width="8" Height="8" Fill="#E74C3C" Margin="0,0,5,0"/>
                            <TextBlock x:Name="lblStatusRed" Text="Sin conexión" Foreground="#BDC3C7" FontSize="10"/>
                        </StackPanel>
                        <TextBlock Text="v1.0.2" Foreground="#5D6D7E" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button x:Name="btnSalir" Content="❌ Cerrar Sistema" Click="btnSalir_Click" 
            Background="#E74C3C" Foreground="White" Height="40" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="© 2026 Parking Express" Foreground="#5D6D7E" 
               FontSize="9" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Panel de Control Principal" FontSize="28" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <Separator Height="20" Background="#D1D8E0"/>
                </StackPanel>

                <Image Source="Imagenes/LogoCompleto.png" 
                       Width="120" Height="60" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Top" 
                       Stretch="Uniform"
                       Margin="0,0,5,0"/>
            </Grid>

            <Border Background="White" Margin="0,60,0,0" CornerRadius="15">
                <Grid x:Name="ContenedorPrincipal">
                    <TextBlock Text="Bienvenido. Seleccione una operación." 
                               VerticalAlignment="Center" HorizontalAlignment="Center" 
                               Foreground="#95A5A6" FontSize="16"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>