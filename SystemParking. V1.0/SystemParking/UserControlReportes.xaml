<UserControl x:Class="SystemParking.UserControlReportes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20,15" BorderThickness="0,0,0,1" BorderBrush="#DEE2E6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="PANEL DE REPORTES" FontSize="20" FontWeight="Black" Foreground="#2C3E50"/>
                        <TextBlock Text="Análisis y estadísticas de Parking Express" FontSize="12" Foreground="#7F8C8D"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="btnCerrarVista" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Width="35" Height="35" Background="#FADBD8" Foreground="#E74C3C" 
                        FontWeight="Bold" BorderThickness="0" Click="btnCerrarVista_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="17"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="3" Margin="20,15">
            <Border Background="White" Margin="0,0,10,0" Padding="15" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Ingresos Hoy" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="lblIngresoHoy" Text="$ 0.00" Foreground="#27AE60" FontSize="24" FontWeight="Black"/>
                </StackPanel>
            </Border>
            <Border Background="White" Margin="5,0" Padding="15" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Vehículos Atendidos" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="lblAutosHoy" Text="0" Foreground="#3498DB" FontSize="24" FontWeight="Black"/>
                </StackPanel>
            </Border>
            <Border Background="White" Margin="10,0,0,0" Padding="15" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Ocupación Actual" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="lblOcupacion" Text="0 %" Foreground="#F39C12" FontSize="24" FontWeight="Black"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="#EBEDEF" Margin="20,5" Padding="20" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Tipo de Reporte" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbTipoReporte" Width="220" Height="35" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Corte de Caja Diario" IsSelected="True"/>
                        <ComboBoxItem Content="Lista de Entradas y Salidas"/>
                        <ComboBoxItem Content="Ingresos Mensuales"/>
                        <ComboBoxItem Content="Vehículos con más tiempo"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Desde" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpDesde" Width="130" Height="35" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Hasta" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpHasta" Width="130" Height="35" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnGenerarReporte" Content="🔍 FILTRAR" Width="120" Height="35" 
                        Background="#3498DB" Foreground="White" FontWeight="Bold" 
                        Margin="10,15,0,0" Cursor="Hand" BorderThickness="0" Click="btnGenerarReporte_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dgReportes" Grid.Row="0" Background="White" BorderBrush="#DEE2E6"
          AutoGenerateColumns="True" IsReadOnly="True" FontSize="13" 
          AlternatingRowBackground="#F8F9FA" RowHeight="35" GridLinesVisibility="None"
          HorizontalGridLinesBrush="#F1F2F6" RowHeaderWidth="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3498DB"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="btnExportarExcel" Content="📁 Excel" Background="#217346" Foreground="White" 
                        Width="100" Height="35" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Click="btnExportarExcel_Click"/>
                <Button x:Name="btnExportarPDF" Content="📕 PDF" Background="#C0392B" Foreground="White" 
                        Width="100" Height="35" BorderThickness="0" FontWeight="Bold" Click="btnExportarPDF_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>