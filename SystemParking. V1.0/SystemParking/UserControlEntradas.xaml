<UserControl x:Class="SystemParking.UserControlEntradas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="White">
        <TextBlock Text="REGISTRO DE ENTRADA" FontSize="24" FontWeight="Bold" 
                   Foreground="#1ABC9C" Margin="20"/>

        <Button x:Name="btnCerrarVista" Content="X" 
        HorizontalAlignment="Right" 
        VerticalAlignment="Top" 
        Width="30" Height="30" 
        Margin="0,10,10,0" 
        Background="#E74C3C" 
        Foreground="White" FontWeight="Bold" BorderThickness="0"
        Click="btnCerrarVista_Click" Cursor="Hand"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">

            <TextBlock Text="Número de Placa" FontSize="16" Foreground="#34495E" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPlaca" FontSize="36" FontWeight="Bold" CharacterCasing="Upper"
                     TextAlignment="Center" Padding="10" Background="#F8F9F9" 
                     BorderBrush="#1ABC9C" BorderThickness="2" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Hora de Ingreso: " FontSize="18" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="lblHoraEntrada" Text="00:00:00" FontSize="18" 
                               FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
            </Grid>

            <Button x:Name="btnRegistrar" Content="REGISTRAR ENTRADA" Height="60" 
                    Background="#1ABC9C" Foreground="White" FontSize="20" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Click="btnRegistrar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>